    "@clerk/backend": "3.13.1",
    "@clerk/shared": "4.30.1",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "0.147.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "1.18.15",
    "@tailwindcss/cli": "^4.1.18",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "opencode-ai": "1.18.15",
