  },
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-MIT",
  "bin": "./bin/weaver.mjs",
  "scripts": {
    "build:ui": "tailwindcss -i src/ui/inspect/styles.css -o src/ui/inspect/tailwind.generated.css --minify",
    "eval:harness": "node --import tsx src/evals/cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck .railway/railway.ts",
    "weaver": "tsx src/cli.ts",
    "test": "tsx --test 'src/**/*.test.ts'"
  }
